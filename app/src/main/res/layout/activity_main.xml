<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- LAUNCH / SPLASH — rebuilt to match the reference -->
    <LinearLayout
        android:id="@+id/welcomeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="42dp"
        android:paddingBottom="18dp"
        android:background="@drawable/bg_welcome">

        <Space android:layout_width="1dp" android:layout_height="10dp"/>

        <ImageView
            android:id="@+id/welcomeLogo"
            android:layout_width="154dp"
            android:layout_height="154dp"
            android:src="@drawable/ic_scanner_logo"
            android:contentDescription="QR Scanner"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/welcomeQrTitle"
                android:text="QR"
                android:textColor="@color/orange"
                android:textSize="39sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/welcomeScannerTitle"
                android:text=" Scanner"
                android:textColor="@color/ink"
                android:textSize="38sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:id="@+id/welcomeSubtitle"
            android:text="Scan Anything, Anytime"
            android:textColor="@color/muted"
            android:textSize="14sp"/>

        <ProgressBar
            android:layout_width="230dp"
            android:layout_height="8dp"
            android:layout_marginTop="58dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="72"
            style="?android:attr/progressBarStyleHorizontal"
            android:progressTint="@color/orange"
            android:progressBackgroundTint="@color/line"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:gravity="center"
            android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_qr_small" android:contentDescription="QR Code"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:id="@+id/featureQrLabel" android:text="QR Code" android:textColor="@color/ink" android:textSize="11sp"/>
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="38dp" android:background="@color/line"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_barcode" android:contentDescription="Barcode"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:id="@+id/featureBarcodeLabel" android:text="Barcode" android:textColor="@color/ink" android:textSize="11sp"/>
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="38dp" android:background="@color/line"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_document" android:contentDescription="and More"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:id="@+id/featureMoreLabel" android:text="and More" android:textColor="@color/ink" android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:gravity="center"
            android:id="@+id/welcomeTagline"
            android:text="Scan a Smarter World"
            android:textColor="@color/muted"
            android:textSize="18sp"
            android:fontFamily="cursive"/>

        <Button
            android:id="@+id/startScanButton"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="visible"
            android:alpha="0"/>

    </LinearLayout>

    <!-- SCANNER -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_welcome"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageButton android:id="@+id/settingsButton" android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp" android:src="@drawable/ic_menu" android:tint="@color/ink" android:background="@android:color/transparent" android:contentDescription="Menu"
                android:clickable="false"
                android:focusable="false"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QR"
                    android:textColor="@color/orange"
                    android:textSize="23sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Scanner"
                    android:textColor="@color/ink"
                    android:textSize="23sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:id="@+id/languageButton"
                android:layout_width="48dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="BM"
                android:textColor="@color/orange"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_language"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Bahasa"/>

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/camera_dark"
            android:clipToOutline="true">

            <androidx.camera.view.PreviewView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:scaleType="fillCenter"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_camera_overlay"/>

            <TextView
                android:id="@+id/cameraMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_camera_hint"
                android:paddingStart="20dp"
                android:paddingEnd="18dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="Halakan QR / barcode ke ruang ini"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <FrameLayout
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:layout_gravity="center">

                <View
                    android:id="@+id/scanFrame"
                    android:layout_width="286dp"
                    android:layout_height="286dp"
                    android:layout_gravity="center"
                    android:background="@drawable/scan_frame"/>

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:gravity="center"
                android:layout_marginBottom="26dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/zoomOneButton"
                    android:layout_width="58dp"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="1x"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:background="@drawable/bg_primary"/>

                <Button
                    android:id="@+id/zoomTwoButton"
                    android:layout_width="58dp"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="2x"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_hint"/>
            </LinearLayout>

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@color/camera_dark"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="82dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton android:id="@+id/flashButton" android:layout_width="56dp" android:layout_height="56dp" android:padding="16dp" android:src="@drawable/ic_flash" android:tint="@color/white" android:background="@drawable/bg_control" android:contentDescription="Flash"/>

                <TextView
                    android:id="@+id/flashLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Flash"
                    android:textColor="@color/white"
                    android:textSize="12sp"/>
            </LinearLayout>

            <ImageButton android:id="@+id/scanAgainButton" android:layout_width="76dp" android:layout_height="76dp" android:padding="21dp" android:src="@drawable/ic_scan" android:tint="@color/white" android:background="@drawable/bg_scan_button" android:contentDescription="Scan"/>

            <LinearLayout
                android:layout_width="82dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton android:id="@+id/galleryButton" android:layout_width="56dp" android:layout_height="56dp" android:padding="16dp" android:src="@drawable/ic_gallery" android:tint="@color/white" android:background="@drawable/bg_control" android:contentDescription="Galeri"/>

                <TextView
                    android:id="@+id/galleryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Galeri"
                    android:textColor="@color/white"
                    android:textSize="12sp"/>
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="Sedia untuk scan"/>

        <Button
            android:id="@+id/permissionButton"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"/>

        <com.google.android.gms.ads.AdView
            android:id="@+id/bannerAd"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:visibility="gone"
            ads:adSize="BANNER"
            ads:adUnitId="ca-app-pub-3940256099942544/9214589741"/>

        <include
            android:id="@+id/nativeAdContainer"
            layout="@layout/native_ad"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:background="@color/surface"
            android:gravity="center"
            android:orientation="horizontal"
            android:elevation="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="7dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageButton
                    android:id="@+id/bottomScanButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_home"
                    android:tint="@color/orange"
                    android:background="@drawable/bg_nav_selected"
                    android:contentDescription="Scan"/>
                <TextView
                    android:id="@+id/bottomScanLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Scan"
                    android:textColor="@color/orange"
                    android:textSize="10sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageButton
                    android:id="@+id/bottomHistoryButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_clock"
                    android:tint="@color/ink"
                    android:background="@drawable/bg_nav_icon"
                    android:contentDescription="Sejarah"/>
                <TextView
                    android:id="@+id/bottomHistoryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Sejarah"
                    android:textColor="@color/ink"
                    android:textSize="10sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageButton
                    android:id="@+id/bottomSettingsButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/ink"
                    android:background="@drawable/bg_nav_icon"
                    android:contentDescription="Tetapan"/>
                <TextView
                    android:id="@+id/bottomSettingsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Tetapan"
                    android:textColor="@color/ink"
                    android:textSize="10sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageButton
                    android:id="@+id/bottomMoreButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_more"
                    android:tint="@color/ink"
                    android:background="@drawable/bg_nav_icon"
                    android:contentDescription="Lainnya"/>
                <TextView
                    android:id="@+id/bottomMoreLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Lainnya"
                    android:textColor="@color/ink"
                    android:textSize="10sp"/>
            </LinearLayout>

        </LinearLayout>>
    </LinearLayout>

    <!-- RESULT — compact full-screen, no scrolling -->
    <LinearLayout
        android:id="@+id/resultScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg"
        android:visibility="gone"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/resultBackButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_back"
                android:tint="@color/ink"
                android:background="@drawable/bg_nav_icon"
                android:contentDescription="Kembali"/>

            <TextView
                android:id="@+id/resultTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Hasil Scan"
                android:textColor="@color/ink"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_result"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/resultIcon"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:padding="13dp"
                android:src="@drawable/ic_qr_small"
                android:tint="@color/white"
                android:background="@drawable/bg_result_icon"
                android:contentDescription="QR"/>

            <TextView
                android:id="@+id/resultType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Website"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:textColor="#1956D1"
                android:textSize="15sp"
                android:maxLines="2"
                android:ellipsize="middle"/>

            <Button
                android:id="@+id/openButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:text="Buka Link"
                android:drawableStart="@drawable/ic_link"
                android:drawableTint="@color/white"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_primary"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/copyButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Salin"
                    android:drawableStart="@drawable/ic_copy"
                    android:drawableTint="@color/ink"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:background="@drawable/bg_glass"/>

                <Button
                    android:id="@+id/shareButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Kongsi"
                    android:drawableStart="@drawable/ic_share"
                    android:drawableTint="@color/ink"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:background="@drawable/bg_glass"/>

                <Button
                    android:id="@+id/saveHistoryButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Simpan"
                    android:drawableStart="@drawable/ic_clock"
                    android:drawableTint="@color/ink"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:background="@drawable/bg_glass"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="7dp"
                android:orientation="vertical"
                android:background="@drawable/bg_result"
                android:padding="12dp">

                <TextView
                    android:id="@+id/resultInfoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Maklumat"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/resultInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:maxLines="3"
                    android:textColor="@color/muted"
                    android:textSize="12sp"/>

            </LinearLayout>

            <Button
                android:id="@+id/resultScanAgainButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="7dp"
                android:text="Scan Lagi"
                android:drawableStart="@drawable/ic_scan"
                android:drawableTint="@color/white"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_primary"/>

        </LinearLayout>
    </LinearLayout>
</FrameLayout>