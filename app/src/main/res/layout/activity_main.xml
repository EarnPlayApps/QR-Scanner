<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/welcomeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="34dp"
        android:paddingBottom="24dp"
        android:background="@color/bg">

        <Space android:layout_width="1dp" android:layout_height="28dp"/>

        <ImageView
            android:id="@+id/welcomeLogo"
            android:layout_width="126dp"
            android:layout_height="126dp"
            android:src="@drawable/ic_scanner_logo"
            android:contentDescription="QR Scanner"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QR"
                android:textColor="@color/orange"
                android:textSize="36sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Scanner"
                android:textColor="@color/ink"
                android:textSize="36sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Scan QR &amp; Barcode dengan pantas"
            android:textColor="@color/muted"
            android:textSize="14sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical"
            android:background="@drawable/bg_result"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SATU APP, SEMUA SCAN"
                android:textColor="@color/orange"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="QR Code  •  Barcode  •  Galeri"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Pilih Mula Scan untuk membuka kamera."
                android:textColor="@color/muted"
                android:textSize="12sp"/>
        </LinearLayout>

        <Button
            android:id="@+id/startScanButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_primary"
            android:text="Mula Scan"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:gravity="center"
            android:text="Cepat • Mudah • Selamat"
            android:textColor="@color/muted"
            android:textSize="11sp"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_scanner_logo"
                android:contentDescription="QR Scanner"
                android:layout_marginEnd="9dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QR"
                    android:textColor="@color/orange"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Scanner"
                    android:textColor="@color/ink"
                    android:textSize="22sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <Button
                android:id="@+id/settingsButton"
                android:layout_width="82dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="Tetapan"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/ink"
                android:background="@drawable/bg_glass"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Halakan QR atau barcode ke dalam bingkai"
            android:textColor="@color/muted"
            android:textSize="12sp"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="258dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_camera"
            android:clipToOutline="true">

            <androidx.camera.view.PreviewView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:scaleType="fillCenter"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_camera_overlay"/>

            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center">

                <View
                    android:id="@+id/scanFrame"
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:layout_gravity="center"
                    android:background="@drawable/scan_frame"/>

                <TextView
                    android:id="@+id/cameraMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_hint"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Letak QR atau barcode dalam bingkai"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="9dp"
                android:background="@drawable/bg_hint"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="LIVE CAMERA"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"/>
        </FrameLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingTop="5dp"
            android:text="Sedia untuk scan"
            android:textColor="@color/muted"
            android:textSize="11sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/flashButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="Flash"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="12sp"
                android:background="@drawable/bg_glass"/>

            <Space android:layout_width="8dp" android:layout_height="1dp"/>

            <Button
                android:id="@+id/scanAgainButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="Scan Lagi"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="12sp"
                android:background="@drawable/bg_primary"
                android:visibility="gone"/>

            <Button
                android:id="@+id/galleryButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="Galeri"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="12sp"
                android:background="@drawable/bg_glass"/>
        </LinearLayout>

        <com.google.android.gms.ads.AdView
            android:id="@+id/bannerAd"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            ads:adSize="BANNER"
            ads:adUnitId="ca-app-pub-3940256099942544/9214589741"/>

        <include
            android:id="@+id/nativeAdContainer"
            layout="@layout/native_ad"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/permissionButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:text="Benarkan Kamera"
            android:textAllCaps="false"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_bottom_nav"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/bottomScanButton"
                style="@style/BottomNavButton"
                android:text="Scan"
                android:textColor="@color/orange"/>

            <Button
                android:id="@+id/bottomHistoryButton"
                style="@style/BottomNavButton"
                android:text="Sejarah"/>

            <Button
                android:id="@+id/bottomSettingsButton"
                style="@style/BottomNavButton"
                android:text="Tetapan"/>

            <Button
                android:id="@+id/bottomMoreButton"
                style="@style/BottomNavButton"
                android:text="Lainnya"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/resultScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="@color/bg"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/resultBackButton"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="‹"
                android:textSize="26sp"
                android:textColor="@color/ink"
                android:background="@drawable/bg_glass"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Hasil Scan"
                android:textColor="@color/ink"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_scanner_logo"
                android:contentDescription="QR Scanner"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@drawable/bg_result"
            android:padding="20dp">

            <TextView
                android:id="@+id/resultType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QR_CODE"
                android:textColor="@color/orange"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass"
                android:padding="16dp"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:maxLines="8"
                android:ellipsize="middle"/>

            <Button
                android:id="@+id/openButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:text="Buka Link"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/bg_primary"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/copyButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Salin"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:background="@drawable/bg_glass"/>

                <Space android:layout_width="8dp" android:layout_height="1dp"/>

                <Button
                    android:id="@+id/shareButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Kongsi"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:background="@drawable/bg_glass"/>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.gms.ads.AdView
            android:id="@+id/resultBannerAd"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            ads:adSize="BANNER"
            ads:adUnitId="ca-app-pub-3940256099942544/9214589741"/>

        <Button
            android:id="@+id/resultScanAgainButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Scan Lagi"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:background="@drawable/bg_primary"/>
    </LinearLayout>
</FrameLayout>