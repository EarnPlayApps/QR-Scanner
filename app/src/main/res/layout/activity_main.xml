<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:text="QR Scanner"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/ink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Scan QR codes and barcodes quickly"
            android:textSize="14sp"
            android:textColor="@color/muted"
            android:layout_marginTop="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fillCenter"/>

        <View
            android:id="@+id/scanFrame"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_gravity="center"
            android:background="@drawable/scan_frame"/>

        <TextView
            android:id="@+id/cameraMessage"
            android:text="Point camera at a QR code or barcode"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:background="#66000000"
            android:padding="10dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/flashButton"
            android:text="Flash"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"/>

        <Space android:layout_width="10dp" android:layout_height="1dp"/>

        <Button
            android:id="@+id/galleryButton"
            android:text="Gallery"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"/>

        <Space android:layout_width="10dp" android:layout_height="1dp"/>

        <Button
            android:id="@+id/historyButton"
            android:text="History"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/permissionButton"
        android:text="Allow Camera"
        android:visibility="gone"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="52dp"/>
</LinearLayout>
