<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="18dp"
            android:paddingBottom="14dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:text="QR Scanner"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Scan QR &amp; barcode dengan pantas"
                    android:textSize="13sp"
                    android:textColor="@color/muted"
                    android:layout_marginTop="3dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <Button
                android:id="@+id/settingsButton"
                android:text="Tetapan"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:layout_width="wrap_content"
                android:layout_height="42dp"/>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_round"
            android:padding="15dp">

            <androidx.camera.view.PreviewView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:scaleType="fillCenter"/>

            <View
                android:id="@+id/scanFrame"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:background="@drawable/scan_frame"/>

            <TextView
                android:id="@+id/cameraMessage"
                android:text="Letak QR / barcode dalam petak"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="#99000000"
                android:paddingStart="13dp"
                android:paddingTop="8dp"
                android:paddingEnd="13dp"
                android:paddingBottom="8dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>

        <TextView
            android:id="@+id/statusText"
            android:text="Sedia untuk scan"
            android:textSize="13sp"
            android:textColor="@color/muted"
            android:gravity="center"
            android:paddingTop="11dp"
            android:paddingBottom="7dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/flashButton"
                android:text="Flash"
                android:minHeight="0dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"/>

            <Space android:layout_width="7dp" android:layout_height="1dp"/>

            <Button
                android:id="@+id/galleryButton"
                android:text="Galeri"
                android:minHeight="0dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"/>

            <Space android:layout_width="7dp" android:layout_height="1dp"/>

            <Button
                android:id="@+id/historyButton"
                android:text="Sejarah"
                android:minHeight="0dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/scanAgainButton"
            android:text="Scan Lagi"
            android:visibility="gone"
            android:layout_marginTop="9dp"
            android:minHeight="0dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>

        <include
            layout="@layout/native_ad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"/>

        <com.google.android.gms.ads.AdView
            android:id="@+id/bannerAd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="7dp"
            ads:adSize="BANNER"
            ads:adUnitId="ca-app-pub-3940256099942544/9214589741" />

        <Button
            android:id="@+id/permissionButton"
            android:text="Benarkan Kamera"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:minHeight="0dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>
    </LinearLayout>
</ScrollView>