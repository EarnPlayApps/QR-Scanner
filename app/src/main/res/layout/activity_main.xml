<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- LAUNCH / SPLASH — rebuilt to match the reference -->
    <LinearLayout
        android:id="@+id/welcomeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="30dp"
        android:paddingBottom="16dp"
        android:background="@color/bg">

        <Space android:layout_width="1dp" android:layout_height="10dp"/>

        <ImageView
            android:id="@+id/welcomeLogo"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:src="@drawable/ic_scanner_logo"
            android:contentDescription="QR Scanner"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QR"
                android:textColor="@color/orange"
                android:textSize="38sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Scanner"
                android:textColor="@color/ink"
                android:textSize="38sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:id="@+id/welcomeSubtitle"
            android:text="Scan Anything, Anytime"
            android:textColor="@color/muted"
            android:textSize="14sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="QR Code"
                android:textColor="@color/ink"
                android:textSize="11sp"/>

            <View android:layout_width="1dp" android:layout_height="22dp" android:background="@color/line"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Barcode"
                android:textColor="@color/ink"
                android:textSize="11sp"/>

            <View android:layout_width="1dp" android:layout_height="22dp" android:background="@color/line"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="and More"
                android:textColor="@color/ink"
                android:textSize="11sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:id="@+id/welcomeTagline"
            android:text="Scan a Smarter World"
            android:textColor="@color/muted"
            android:textSize="16sp"
            android:textStyle="normal"/>

        <Button
            android:id="@+id/startScanButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_language"
            android:text="Mula Scan"
            android:textColor="@color/orange"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"/>

    </LinearLayout>

    <TextView android:id="@+id/welcomeAdLabel" android:layout_width="wrap_content" android:layout_height="24dp" android:layout_gravity="bottom|end" android:layout_marginEnd="8dp" android:layout_marginBottom="50dp" android:drawableStart="@drawable/ic_ad" android:drawableTint="@color/orange" android:drawablePadding="4dp" android:gravity="center" android:paddingStart="8dp" android:paddingEnd="8dp" android:text="Iklan / Ad" android:textColor="@color/orange_dark" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/bg_ad_badge" android:visibility="gone"/>

    <!-- Welcome banner: shown only on launch screen. -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/welcomeBannerAd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:visibility="gone"
        android:background="@drawable/bg_ad_banner"
        android:padding="3dp"
        ads:adSize="BANNER"
        ads:adUnitId="@string/admob_banner_id"/>

    <!-- SCANNER -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <Button
                android:id="@+id/settingsButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text=""
                android:drawableTop="@drawable/ic_menu"
                android:drawableTint="@color/orange"
                android:gravity="center"
                android:padding="9dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Menu"
                android:background="@drawable/bg_glass"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QR"
                    android:textColor="@color/orange"
                    android:textSize="23sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Scanner"
                    android:textColor="@color/ink"
                    android:textSize="23sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <Button
                android:id="@+id/flashHeaderButton"
                android:layout_width="50dp"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="BM"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/orange"
                android:gravity="center"
                android:padding="0dp"
                android:background="@drawable/bg_language"/>

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/camera_dark"
            android:clipToOutline="true">

            <androidx.camera.view.PreviewView
                android:id="@+id/preview"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="center"
                android:background="@color/camera_dark"
                app:scaleType="fillCenter"/>

            <!-- Keep the camera preview inside the scan area, not across the whole screen. -->

            <TextView
                android:id="@+id/cameraMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_hint"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="Halakan QR / barcode ke ruang ini"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <FrameLayout
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:layout_gravity="center">

                <View
                    android:id="@+id/scanFrame"
                    android:layout_width="280dp"
                    android:layout_height="280dp"
                    android:layout_gravity="center"
                    android:background="@drawable/scan_frame"/>

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:gravity="center"
                android:layout_marginBottom="26dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/zoomOneButton"
                    android:layout_width="58dp"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="1x"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:background="@drawable/bg_primary"/>

                <Button
                    android:id="@+id/zoomTwoButton"
                    android:layout_width="58dp"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="2x"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_hint"/>
            </LinearLayout>

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@color/camera_dark"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="82dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <Button
                    android:id="@+id/flashButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text=""
                    android:drawableTop="@drawable/ic_flash"
                    android:drawableTint="@color/white"
                    android:padding="14dp"
                    android:background="@drawable/bg_hint"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Flash"
                    android:textColor="@color/white"
                    android:textSize="12sp"/>
            </LinearLayout>

            <Button
                android:id="@+id/scanAgainButton"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="SCAN"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_primary"/>

            <LinearLayout
                android:layout_width="82dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <Button
                    android:id="@+id/galleryButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text=""
                    android:drawableTop="@drawable/ic_gallery"
                    android:drawableTint="@color/white"
                    android:padding="14dp"
                    android:background="@drawable/bg_hint"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Galeri"
                    android:textColor="@color/white"
                    android:textSize="12sp"/>
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="Sedia untuk scan"/>

        <Button
            android:id="@+id/permissionButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone"
            android:text="Benarkan Kamera"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/bg_primary"
            android:minWidth="0dp"
            android:minHeight="0dp"/>

        <TextView android:id="@+id/scannerAdLabel" android:layout_width="wrap_content" android:layout_height="22dp" android:layout_gravity="end" android:drawableStart="@drawable/ic_ad" android:drawableTint="@color/orange" android:drawablePadding="4dp" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:text="Iklan / Ad" android:textColor="@color/orange_dark" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/bg_ad_badge" android:visibility="gone"/>

        <com.google.android.gms.ads.AdView
            android:id="@+id/bannerAd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_ad_banner"
            android:padding="3dp"
            android:visibility="gone"
            ads:adSize="BANNER"
            ads:adUnitId="@string/admob_banner_id"/>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:background="@color/surface"
            android:gravity="center"
            android:orientation="horizontal"
            android:elevation="8dp">

            <Button
                android:id="@+id/bottomScanButton"
                style="@style/BottomNavButton"
                android:text="Scan"
                android:drawableTop="@drawable/ic_scan"
                android:drawableTint="@color/orange"
                android:drawablePadding="2dp"
                android:textColor="@color/orange"/>

            <Button
                android:id="@+id/bottomHistoryButton"
                style="@style/BottomNavButton"
                android:drawableTop="@drawable/ic_clock"
                android:drawableTint="@color/ink"
                android:drawablePadding="2dp"
                android:text="Sejarah"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="10sp"
                android:background="@android:color/transparent"/>

            <Button
                android:id="@+id/bottomSettingsButton"
                style="@style/BottomNavButton"
                android:drawableTop="@drawable/ic_settings"
                android:drawableTint="@color/ink"
                android:drawablePadding="2dp"
                android:text="Tetapan"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="10sp"
                android:background="@android:color/transparent"/>

            <Button
                android:id="@+id/bottomMoreButton"
                style="@style/BottomNavButton"
                android:drawableTop="@drawable/ic_more"
                android:drawableTint="@color/ink"
                android:drawablePadding="2dp"
                android:text="Lainnya"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="10sp"
                android:background="@android:color/transparent"/>

        </LinearLayout>
    </LinearLayout>

    <!-- RESULT -->
    <ScrollView
        android:id="@+id/resultScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/bg"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/resultBackButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="‹"
                    android:textSize="28sp"
                    android:textColor="@color/ink"
                    android:background="@android:color/transparent"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:id="@+id/resultTitle"
                    android:text="Hasil Scan"
                    android:textColor="@color/ink"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <View android:layout_width="44dp" android:layout_height="44dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_result"
                android:padding="12dp">

                <ImageView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:padding="13dp"
                    android:src="@drawable/ic_qr_small"
                    android:tint="@color/white"
                    android:background="@drawable/bg_primary"
                    android:contentDescription="QR"/>

                <TextView
                    android:id="@+id/resultType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Website"
                    android:textColor="@color/ink"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/resultText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:textColor="#1956D1"
                    android:textSize="14sp"
                    android:maxLines="5"
                    android:ellipsize="middle"
                    android:textIsSelectable="true"/>

                <Button
                    android:id="@+id/openButton"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="7dp"
                    android:text="Buka Link"
                    android:drawableStart="@drawable/ic_link"
                    android:drawableTint="@color/white"
                    android:drawablePadding="7dp"
                    android:gravity="center"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_primary"/>

                <Button
                    android:id="@+id/copyButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="5dp"
                    android:text="Salin Link"
                    android:drawableStart="@drawable/ic_copy"
                    android:drawableTint="@color/ink"
                    android:drawablePadding="7dp"
                    android:gravity="center"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:background="@drawable/bg_glass"/>

                <Button
                    android:id="@+id/shareButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:text="Kongsi"
                    android:drawableStart="@drawable/ic_share"
                    android:drawableTint="@color/ink"
                    android:drawablePadding="7dp"
                    android:gravity="center"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:background="@drawable/bg_glass"/>

                <Button
                    android:id="@+id/saveHistoryButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:text="Simpan ke Sejarah"
                    android:drawableStart="@drawable/ic_clock"
                    android:drawableTint="@color/ink"
                    android:drawablePadding="7dp"
                    android:gravity="center"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:background="@drawable/bg_glass"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:background="@drawable/bg_result"
                android:padding="10dp">

                <TextView
                    android:id="@+id/resultInfoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Maklumat"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/resultInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Jenis                                      QR Code&#10;Kandungan                            URL&#10;Masa                                      —"
                    android:textColor="@color/muted"
                    android:textSize="13sp"/>

            </LinearLayout>

            <FrameLayout
                android:id="@+id/nativeAdContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone">

                <include
                    layout="@layout/native_ad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </FrameLayout>

            <TextView android:id="@+id/resultAdLabel" android:layout_width="wrap_content" android:layout_height="22dp" android:layout_gravity="end" android:layout_marginTop="8dp" android:drawableStart="@drawable/ic_ad" android:drawableTint="@color/orange" android:drawablePadding="4dp" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:text="Iklan / Ad" android:textColor="@color/orange_dark" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/bg_ad_badge" android:visibility="gone"/>

            <com.google.android.gms.ads.AdView
                android:id="@+id/resultBannerAd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_ad_banner"
                android:padding="3dp"
                android:visibility="gone"
                ads:adSize="BANNER"
                ads:adUnitId="@string/admob_banner_id"/>

            <Button
                android:id="@+id/resultScanAgainButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="6dp"
                android:text="Scan Lagi"
                android:drawableStart="@drawable/ic_scan"
                android:drawableTint="@color/white"
                android:drawablePadding="7dp"
                android:gravity="center"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_primary"/>

        </LinearLayout>
    </ScrollView>
</FrameLayout>