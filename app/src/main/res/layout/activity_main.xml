<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="0dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_scanner_logo"
                android:contentDescription="QR Scanner"
                android:layout_marginEnd="9dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QR"
                    android:textColor="@color/orange"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Scanner"
                    android:textColor="@color/ink"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"/>
            </LinearLayout>

            <Button
                android:id="@+id/settingsButton"
                android:layout_width="58dp"
                android:layout_height="42dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="Flash"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/ink"
                android:background="@drawable/bg_glass"/>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="250dp"
            android:background="@drawable/bg_camera">

            <androidx.camera.view.PreviewView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:scaleType="fillCenter"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_camera_overlay"/>

            <FrameLayout
                android:layout_width="224dp"
                android:layout_height="224dp"
                android:layout_gravity="center">

                <View
                    android:id="@+id/scanFrame"
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:layout_gravity="center"
                    android:background="@drawable/scan_frame"/>

                <TextView
                    android:id="@+id/cameraMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_hint"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="Halakan QR / barcode ke ruang ini"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_hint"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="QR Code • Barcode"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </FrameLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="Sedia untuk scan"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:paddingTop="5dp"
            android:paddingBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/flashButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="Flash"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="11sp"
                android:background="@drawable/bg_glass"/>

            <Space android:layout_width="8dp" android:layout_height="1dp"/>

            <Button
                android:id="@+id/scanAgainButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="Scan"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="12sp"
                android:background="@drawable/bg_primary"/>

            <Space android:layout_width="8dp" android:layout_height="1dp"/>

            <Button
                android:id="@+id/galleryButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="Galeri"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="11sp"
                android:background="@drawable/bg_glass"/>
        </LinearLayout>

        <com.google.android.gms.ads.AdView
            android:id="@+id/bannerAd"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="2dp"
            ads:adSize="BANNER"
            ads:adUnitId="ca-app-pub-3940256099942544/9214589741"/>

        <include
            android:id="@+id/nativeAdContainer"
            layout="@layout/native_ad"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/permissionButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Benarkan Kamera"
            android:textAllCaps="false"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_bottom_nav"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">

            <Button
                android:id="@+id/bottomScanButton"
                style="@style/BottomNavButton"
                android:text="Scan"
                android:textColor="@color/orange"/>

            <Button
                android:id="@+id/bottomHistoryButton"
                style="@style/BottomNavButton"
                android:text="Sejarah"/>

            <Button
                android:id="@+id/bottomSettingsButton"
                style="@style/BottomNavButton"
                android:text="Tetapan"/>

            <Button
                android:id="@+id/bottomMoreButton"
                style="@style/BottomNavButton"
                android:text="Lainnya"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/welcomeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="30dp"
        android:paddingBottom="24dp"
        android:background="@color/bg">

        <ImageView
            android:id="@+id/welcomeLogo"
            android:layout_width="138dp"
            android:layout_height="138dp"
            android:src="@drawable/ic_scanner_logo"
            android:contentDescription="QR Scanner"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QR"
                android:textColor="@color/orange"
                android:textSize="38sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Scanner"
                android:textColor="@color/ink"
                android:textSize="38sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Scan Anything, Anytime"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:letterSpacing="0.06"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Fast" android:textColor="@color/ink" android:textStyle="bold" android:textSize="11sp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Private" android:textColor="@color/ink" android:textStyle="bold" android:textSize="11sp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Easy" android:textColor="@color/ink" android:textStyle="bold" android:textSize="11sp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Mobile Ready" android:textColor="@color/ink" android:textStyle="bold" android:textSize="11sp"/>
        </LinearLayout>

        <Button
            android:id="@+id/startScanButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_primary"
            android:text="Mula Scan"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="QR Code • Barcode • Galeri • Sejarah"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"/>
    </LinearLayout>
</FrameLayout>
