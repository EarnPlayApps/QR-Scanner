<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/surface"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:text="Hasil Scan"
        android:textColor="@color/ink"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ImageView
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="center"
        android:layout_marginTop="14dp"
        android:src="@drawable/ic_scanner_logo"
        android:contentDescription="QR Scanner"/>

    <TextView
        android:id="@+id/resultType"
        android:text="QR CODE"
        android:textStyle="bold"
        android:textSize="12sp"
        android:textColor="@color/orange"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/resultText"
        android:textSize="15sp"
        android:textColor="@color/ink"
        android:gravity="center"
        android:layout_marginTop="7dp"
        android:background="@drawable/bg_result"
        android:padding="14dp"
        android:maxLines="5"
        android:ellipsize="middle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/openButton"
        android:text="Buka Link"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:background="@drawable/bg_primary"
        android:layout_marginTop="14dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/copyButton"
            android:text="Salin Link"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:background="@drawable/bg_glass"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"/>

        <Space android:layout_width="8dp" android:layout_height="1dp"/>

        <Button
            android:id="@+id/shareButton"
            android:text="Kongsi"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:background="@drawable/bg_glass"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"/>
    </LinearLayout>
</LinearLayout>
