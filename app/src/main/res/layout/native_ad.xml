<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/nativeAdView" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_round" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageView android:id="@+id/nativeAdIcon" android:layout_width="40dp" android:layout_height="40dp" android:scaleType="centerCrop" android:visibility="gone"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                <TextView android:id="@+id/nativeAdHeadline" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ink" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/nativeAdAdvertiser" android:textSize="11sp" android:textColor="@color/muted" android:layout_marginTop="2dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>
            <TextView android:id="@+id/nativeAdLabel" android:text="Sponsored" android:textSize="10sp" android:textColor="@color/muted" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <com.google.android.gms.ads.nativead.MediaView android:id="@+id/nativeAdMedia" android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/nativeAdBody" android:textSize="13sp" android:textColor="@color/muted" android:layout_marginTop="5dp" android:maxLines="2" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/nativeAdCallToAction" android:text="Learn More" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="9dp"/>
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>